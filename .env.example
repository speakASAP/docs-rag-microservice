# ============================================
# Identity
# ============================================
NODE_ENV=
SERVICE_NAME=docs-rag-microservice
DOMAIN=

# ============================================
# Ports
# ============================================
PORT=3397

# ============================================
# Shared Microservices
# ============================================
AUTH_SERVICE_URL=
LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_PATH=/api/logs
NOTIFICATION_SERVICE_URL=
AI_SERVICE_URL=
MONITORING_SERVICE_URL=

# ============================================
# Database (Shared PostgreSQL)
# ============================================
DB_HOST=
DB_PORT=5432
DB_USER=dbadmin
DB_PASSWORD=
DB_NAME=docs_rag
DATABASE_URL=

# ============================================
# Vector Database (Qdrant)
# ============================================
QDRANT_URL=
QDRANT_COLLECTION=ecosystem-docs

# ============================================
# Embeddings & Git
# ============================================
EMBEDDING_MODEL=text-embedding-3-small
GIT_SYNC_INTERVAL_HOURS=6
GIT_BASE_PATH=/data/repos

# ============================================
# Secrets
# ============================================
JWT_SECRET=
OPENAI_API_KEY=
