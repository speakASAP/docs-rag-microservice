{
  "name": "docs-rag-microservice",
  "version": "1.0.0",
  "description": "Centralized documentation RAG service for the Statex ecosystem",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern='\\.spec\\.ts$'",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "docs:audit": "python3 scripts/strict_doc_audit.py --format markdown --fail-on-issues",
    "gate:pre-coding": "python3 scripts/pre_coding_gate.py --root .",
    "gate:deployment": "python3 scripts/deployment_readiness_gate.py --root ."
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/typeorm": "^11.0.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "marked": "^18.0.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "simple-git": "^3.30.0",
    "typeorm": "^0.3.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.41",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "lodash": "4.18.1",
    "multer": "2.1.1",
    "qs": "6.15.2",
    "uuid": "11.1.1"
  }
}
