# ============================================
# Identity
# ============================================
NODE_ENV=
SERVICE_NAME=docs-rag-microservice
DOMAIN=

# ============================================
# Ports
# ============================================
PORT=3397

# ============================================
# Shared Microservices
# ============================================
AUTH_SERVICE_URL=
LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_PATH=/api/logs
NOTIFICATION_SERVICE_URL=
AI_SERVICE_URL=
MONITORING_SERVICE_URL=

# ============================================
# Database (Shared PostgreSQL)
# ============================================
DB_HOST=
DB_PORT=5432
DB_USER=dbadmin
DB_PASSWORD=
DB_NAME=docs_rag
DATABASE_URL=

# ============================================
# Vector Database (Qdrant)
# ============================================
QDRANT_URL=
QDRANT_COLLECTION=ecosystem-docs

# ============================================
# Embeddings & Git
# ============================================
# Ollama runs as a plain docker container (ai-microservice-ollama-green) on the
# host, NOT in the cluster, so this is a host address rather than a .svc name.
# Port is 11435, not Ollama's 11434 default: the container sets
# OLLAMA_HOST=0.0.0.0:11435. Nothing serves 11434 on this host.
OLLAMA_URL=http://192.168.88.53:11435
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Concurrent embedding requests. Ollama is single-instance: 2 is deliberate.
OLLAMA_EMBED_CONCURRENCY=2
OLLAMA_EMBED_TIMEOUT_MS=60000
# Below this top score, agent-context returns an explicit no-match notice
# instead of presenting weak chunks as an answer.
RAG_CONFIDENT_MATCH_SCORE=0.74
QDRANT_VECTOR_SIZE=768
GIT_SYNC_INTERVAL_HOURS=6
SCHEDULED_INGESTION_ENABLED=false
GIT_BASE_PATH=/data/repos

# ============================================
# Secrets
# ============================================
JWT_SECRET=

JWT_TOKEN=
